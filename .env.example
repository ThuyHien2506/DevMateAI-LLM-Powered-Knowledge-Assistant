# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=devmate_docs

# Embedding Model
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu # or cuda

# LLM Provider (Ollama or API)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen2.5:3b # hoặc qwen3:4b tùy cấu hình máy bạn

# Optional External API (Gemini or OpenAI for backup/evaluation)
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Retrieval Parameters
DEFAULT_TOP_K=5
RRF_K=60
